": [51431, 383, 2995, 286, 262, 1110, 547, 772, 13055, 319, 262, 5389, 286, 511, 47930, 13, 51539], "temperature": 0.0, "avg_logprob": -0.18454340778330647, "compression_ratio": 1.7004830917874396, "no_speech_prob": 0.22066982090473175}, {"id": 42, "seek": 5784, "start": 81.36, "end": 83.92, "text": " And some got spotted by a grandma while dancing on top of the parking lot.", "tokens": [51539, 843, 617, 1392, 13489, 416, 257, 49890, 981, 15360, 319, 1353, 286, 262, 7647, 1256, 13, 51667], "temperature": 0.0, "avg_logprob": -0.18454340778330647, "compression_ratio": 1.7004830917874396, "no_speech_prob": 0.22066982090473175}, {"id": 43, "seek": 5784, "start": 83.92, "end": 86.24000000000001, "text": " When they were supposed to be filming.", "tokens": [51667, 1649, 484, 547, 4385, 284, 307, 17691, 13, 51783], "temperature": 0.0, "avg_logprob": -0.18454340778330647, "compression_ratio": 1.7004830917874396, "no_speech_prob": 0.22066982090473175}, {"id": 44, "seek": 8624, "start": 86.32, "end": 89.44, "text": " Then they got caught again on the George Washington Bridge before they could set one of their vans off.", "tokens": [50367, 3244, 484, 1392, 4978, 757, 319, 262, 4502, 2669, 10290, 878, 484, 714, 900, 530, 286, 511, 47930, 572, 13, 50523], "temperature": 0.0, "avg_logprob": -0.18675205833033512, "compression_ratio": 1.7299771167048055, "no_speech_prob": 0.022070296108722687}, {"id": 45, "seek": 8624, "start": 89.44, "end": 91.91999999999999, "text": " We had to make a cop actually change his story when he went on the radio and said he found", "tokens": [50523, 775, 550, 284, 787, 257, 2243, 1682, 1487, 465, 1621, 618, 339, 1816, 319, 262, 5243, 290, 531, 339, 1043, 50647], "temperature": 0.0, "avg_logprob": -0.18675205833033512, "compression_ratio": 1.7299771167048055, "no_speech_prob": 0.022070296108722687}, {"id": 46, "seek": 8624, "start": 91.91999999999999, "end": 93.19999999999999, "text": " some explosives in the van.", "tokens": [50647, 617, 20732, 287, 26